# ============================================================
# UCrash + LegendaryLeads Backend — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Database (PostgreSQL / Neon / Supabase)
DATABASE_URL=postgresql://user:password@localhost:5432/ucrash

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key

# Redis
REDIS_URL=redis://localhost:6379

# JWT Secrets
JWT_SECRET=change-this-to-a-strong-random-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Twilio (SMS / WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=+1234567890

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@ucrash.claims

# OpenAI (AI services)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Firebase (Push notifications)
FIREBASE_PROJECT_ID=your-firebase-project
FIREBASE_SERVICE_ACCOUNT_KEY=

# Amazon Associates
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_ASSOCIATE_TAG=

# CJ Affiliate
CJ_API_KEY=
CJ_WEBSITE_ID=

# Impact
IMPACT_ACCOUNT_SID=
IMPACT_AUTH_TOKEN=

# ShareASale
SHAREASALE_API_TOKEN=
SHAREASALE_AFFILIATE_ID=

# Google Analytics
GA4_MEASUREMENT_ID=G-XXXXXXXX
GA4_API_SECRET=

# CORS
CORS_ORIGINS=http://localhost:5173,https://ucrash.claims
